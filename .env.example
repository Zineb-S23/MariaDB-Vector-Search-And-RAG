DB_HOST=127.0.0.1
DB_PORT=13307
DB_NAME=wikirag
DB_USER=wikirag
DB_PASSWORD=replace_with_local_password

# MariaDB administrator password used by Docker.
MARIADB_ROOT_PASSWORD=replace_with_local_root_password

# Tests must use a separate database.
DB_NAME_TEST=wikirag_test

# Model shared by ingestion and retrieval.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LOG_LEVEL=INFO

# The default RAG generator works without an external LLM.
LLM_PROVIDER=none
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
